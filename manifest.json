{
  "manifest_version": 3,
  "name": "Nicer ChatGPT",
  "version": "1.0.0",
  "description": "Adds persistent, time-aware timestamps to ChatGPT messages.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "run_at": "document_idle",
      "css": ["styles/content.css"],
      "js": [
        "src/namespace.js",
        "src/time.js",
        "src/marker.js",
        "src/storage.js",
        "src/submission.js",
        "src/compatibility.js",
        "src/export.js",
        "src/messages.js",
        "src/chatgpt-adapter.js",
        "src/presenter.js",
        "src/content.js"
      ]
    }
  ],
  "action": {
    "default_title": "Nicer ChatGPT",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
